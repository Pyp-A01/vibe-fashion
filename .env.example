# [설명] 환경 변수 설정 예시 파일입니다.
# 실제 사용 시에는 이 파일을 복사하여 '.env' 파일로 이름을 변경한 뒤 값을 입력하세요.

# Flask 설정
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=vibe-fashion-secret-key-change-this-in-production

# Supabase 연동 정보 (추후 데이터베이스 연동 시 입력)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
